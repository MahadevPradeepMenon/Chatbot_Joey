# Hey Joey local-development configuration.
# Copy to .env only when you need to override these safe local defaults.

HEY_JOEY_ENVIRONMENT=local
HEY_JOEY_DEMO_MODE=false
HEY_JOEY_DATA_POLICY=local_private
HEY_JOEY_ALLOW_PRIVATE_DATA=false

HEY_JOEY_DATA_DIR=./data
HEY_JOEY_DATABASE_PATH=./data/local/joey.db
HEY_JOEY_API_URL=http://127.0.0.1:8000

HEY_JOEY_LOG_LEVEL=INFO
HEY_JOEY_LOG_FORMAT=text
HEY_JOEY_DOCS_ENABLED=true

HEY_JOEY_API_BIND_HOST=127.0.0.1
HEY_JOEY_API_PORT=8000
HEY_JOEY_FRONTEND_BIND_HOST=127.0.0.1
HEY_JOEY_FRONTEND_PORT=8501
