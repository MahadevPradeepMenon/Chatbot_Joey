# Safe production-demo template.
# Copy to .env.production and review every value before deployment.
# Never commit .env.production.

HEY_JOEY_ENVIRONMENT=production
HEY_JOEY_DEMO_MODE=true
HEY_JOEY_DATA_POLICY=synthetic_only
HEY_JOEY_ALLOW_PRIVATE_DATA=false

HEY_JOEY_DATA_DIR=/app/data
HEY_JOEY_DATABASE_PATH=/app/data/local/joey.db
HEY_JOEY_API_URL=http://api:8000

HEY_JOEY_LOG_LEVEL=INFO
HEY_JOEY_LOG_FORMAT=json
HEY_JOEY_DOCS_ENABLED=false

# Keep the API bound to the host loopback interface by default.
HEY_JOEY_API_BIND_HOST=127.0.0.1
HEY_JOEY_API_PORT=8000
HEY_JOEY_FRONTEND_BIND_HOST=0.0.0.0
HEY_JOEY_FRONTEND_PORT=8501

HEY_JOEY_API_CPUS=2.0
HEY_JOEY_API_MEMORY_LIMIT=2g
HEY_JOEY_FRONTEND_CPUS=1.0
HEY_JOEY_FRONTEND_MEMORY_LIMIT=1g
HEY_JOEY_LOG_MAX_SIZE=10m
HEY_JOEY_LOG_MAX_FILES=3
